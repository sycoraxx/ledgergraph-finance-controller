# Finance Controller configuration
# Copy this file to .env. Never commit .env or real credentials.

# Optional explanation assistant. The controller works safely with "none".
# Supported: none, local, groq, gemini, openai_compatible
FINCTRL_MODEL_PROVIDER=none
FINCTRL_MODEL_TIMEOUT=90

# Hosted AI examples (choose one provider and set only its key).
# GROQ_API_KEY=
# GEMINI_API_KEY=
# FINCTRL_MODEL_API_KEY=
# FINCTRL_MODEL_URL=https://your-openai-compatible-service.example/v1
# FINCTRL_MODEL=your-model-name

# Local llama.cpp / Qwen example.
# FINCTRL_MODEL_URL=http://127.0.0.1:8001/v1
# FINCTRL_MODEL=qwen3.5-4b-q4_k_m

# Browser origins allowed to call the API, separated by commas.
FINCTRL_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional Razorpay Test Mode read-only snapshot. Live keys are rejected.
# RAZORPAY_KEY_ID=rzp_test_replace_me
# RAZORPAY_KEY_SECRET=replace_me
